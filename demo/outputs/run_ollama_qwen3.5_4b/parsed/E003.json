      "speaker": null,
      "raw_label": "ACTION",
      "source_line": 18
    },
    {
      "block_id": "E003-B003",
      "index": 3,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 2.5,
      "end_s": 6.0,
      "start_tc": "00:02.50",
      "end_tc": "00:06.00",
      "text": "Wide shot: a woman in a yellow raincoat stands dripping in the doorway, her phone glowing in her hand.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 22
    },
    {
      "block_id": "E003-B004",
      "index": 4,
      "scene_id": "E003-S01",
      "kind": "SOUND_FX",
      "start_s": 2.8,
      "end_s": 5.8,
      "start_tc": "00:02.80",
      "end_tc": "00:05.80",
      "text": "Rain roars in the stairwell behind her.",
      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 26
    },
    {
      "block_id": "E003-B005",
      "index": 5,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 6.0,
      "end_s": 8.5,
      "start_tc": "00:06.00",
      "end_tc": "00:08.50",
      "text": "Close-up on Nora, backing against the desk.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 30
    },
    {
      "block_id": "E003-B006",
      "index": 6,
      "scene_id": "E003-S01",
      "kind": "DIALOGUE",
      "start_s": 6.3,
      "end_s": 7.9,
      "start_tc": "00:06.30",
      "end_tc": "00:07.90",
      "text": "Who are you?",
      "speaker": {
        "label": "NORA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Terrified"
        ]
      },
      "raw_label": "NORA (Terrified)",
      "source_line": 34
    },
    {
      "block_id": "E003-B007",
      "index": 7,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 8.5,
      "end_s": 17.1,
      "start_tc": "00:08.50",
      "end_tc": "00:17.10",
      "text": "Close-up on the woman as she lowers her hood.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 38
    },
    {
      "block_id": "E003-B008",
      "index": 8,
      "scene_id": "E003-S01",
      "kind": "ACTION",
      "start_s": 8.8,
      "end_s": 10.8,
      "start_tc": "00:08.80",
      "end_tc": "00:10.80",
      "text": "The woman lowers her hood; a pale scar runs along her jaw.",
      "speaker": null,
      "raw_label": "ACTION",
      "source_line": 42
    },
    {
      "block_id": "E003-B009",
      "index": 9,
      "scene_id": "E003-S01",
      "kind": "DIALOGUE",
      "start_s": 11.1,
      "end_s": 16.9,
      "start_tc": "00:11.10",
      "end_tc": "00:16.90",
      "text": "You knew me as Maya. You held on to me in the river.",
      "speaker": {
        "label": "WOMAN IN YELLOW RAINCOAT",
        "character_id": null,
        "alias_hint": "Maya",
        "voice": "ON",
        "delivery": [
          "Steady",
          "Hurt"
        ]
      },
      "raw_label": "WOMAN IN YELLOW RAINCOAT (Maya) (Steady, Hurt)",
      "source_line": 46
    },
    {
      "block_id": "E003-B010",
      "index": 10,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 17.1,
      "end_s": 22.2,
      "start_tc": "00:17.10",
      "end_tc": "00:22.20",
      "text": "Extreme close-up on Nora's face.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 50
    },
    {
      "block_id": "E003-B011",
      "index": 11,
      "scene_id": "E003-S01",
      "kind": "DIALOGUE",
      "start_s": 17.4,
      "end_s": 22.0,
      "start_tc": "00:17.40",
      "end_tc": "00:22.00",
      "text": "Maya Cole? They never found you. They said you drowned.",
      "speaker": {
        "label": "NORA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Stunned",
          "Whispering"
        ]
      },
      "raw_label": "NORA (Stunned, Whispering)",
      "source_line": 54
    },
    {
      "block_id": "E003-B012",
      "index": 12,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 22.2,
      "end_s": 31.9,
      "start_tc": "00:22.20",
      "end_tc": "00:31.90",
      "text": "Two-shot of Nora and Maya.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 58
    },
    {
      "block_id": "E003-B013",
      "index": 13,
      "scene_id": "E003-S01",
      "kind": "DIALOGUE",
      "start_s": 22.5,
      "end_s": 31.7,
      "start_tc": "00:22.50",
      "end_tc": "00:31.70",
      "text": "I washed up two miles downstream. Someone drove onto that bridge with no lights, and drove away when I went over.",
      "speaker": {
        "label": "MAYA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Bitter"
        ]
      },
      "raw_label": "MAYA (Bitter)",
      "source_line": 62
    },
    {
      "block_id": "E003-B014",
      "index": 14,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 31.9,
      "end_s": 34.9,
      "start_tc": "00:31.90",
      "end_tc": "00:34.90",
      "text": "Through the glass, Dev backs away from the window.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 66
    },
    {
      "block_id": "E003-B015",
      "index": 15,
      "scene_id": "E003-S01",
      "kind": "SOUND_FX",
      "start_s": 32.2,
      "end_s": 34.7,
      "start_tc": "00:32.20",
      "end_tc": "00:34.70",
      "text": "A low heartbeat pulse.",
      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 70
    },
    {
      "block_id": "E003-B016",
      "index": 16,
      "scene_id": "E003-S01",
      "kind": "CAMERA",
      "start_s": 34.9,
      "end_s": 42.5,
      "start_tc": "00:34.90",
      "end_tc": "00:42.50",
      "text": "Medium shot of Nora turning to the glass.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 74
    },
    {
      "block_id": "E003-B017",
      "index": 17,
      "scene_id": "E003-S01",
      "kind": "DIALOGUE",
      "start_s": 35.2,
      "end_s": 42.3,
      "start_tc": "00:35.20",
      "end_tc": "00:42.30",
      "text": "You told me it was my fault. You said I panicked and let go of her.",
      "speaker": {
        "label": "NORA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Breaking"
        ]
      },
      "raw_label": "NORA (Breaking)",
      "source_line": 78
    },
    {
      "block_id": "E003-B018",
      "index": 18,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 42.5,
      "end_s": 45.0,
      "start_tc": "00:42.50",
      "end_tc": "00:45.00",
      "text": "Nora storms into the booth.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 89
    },
    {
      "block_id": "E003-B019",
      "index": 19,
      "scene_id": "E003-S02",
      "kind": "ACTION",
      "start_s": 42.8,
      "end_s": 44.0,
      "start_tc": "00:42.80",
      "end_tc": "00:44.00",
      "text": "Nora shoves the booth door open.",
      "speaker": null,
      "raw_label": "ACTION",
      "source_line": 93
    },
    {
      "block_id": "E003-B020",
      "index": 20,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 45.0,
      "end_s": 50.5,
      "start_tc": "00:45.00",
      "end_tc": "00:50.50",
      "text": "Close-up on Dev.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 97
    },
    {
      "block_id": "E003-B021",
      "index": 21,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 45.3,
      "end_s": 50.3,
      "start_tc": "00:45.30",
      "end_tc": "00:50.30",
      "text": "I was nineteen. I'd been drinking. I thought she was gone.",
      "speaker": {
        "label": "DEV",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Desperate",
          "Pleading"
        ]
      },
      "raw_label": "DEV (Desperate, Pleading)",
      "source_line": 101
    },
    {
      "block_id": "E003-B022",
      "index": 22,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 50.5,
      "end_s": 52.5,
      "start_tc": "00:50.50",
      "end_tc": "00:52.50",
      "text": "Close-up on Nora.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 105
    },
    {
      "block_id": "E003-B023",
      "index": 23,
      "scene_id": "E003-S02",
      "kind": "ACTION",
      "start_s": 50.8,
      "end_s": 51.6,
      "start_tc": "00:50.80",
      "end_tc": "00:51.60",
      "text": "Nora slaps Dev across the face.",
      "speaker": null,
      "raw_label": "ACTION",
      "source_line": 109
    },
    {
      "block_id": "E003-B024",
      "index": 24,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 52.5,
      "end_s": 55.0,
      "start_tc": "00:52.50",
      "end_tc": "00:55.00",
      "text": "Close-up on Dev, his cheek reddening.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 113
    },
    {
      "block_id": "E003-B025",
      "index": 25,
      "scene_id": "E003-S02",
      "kind": "SOUND_FX",
      "start_s": 52.8,
      "end_s": 54.3,
      "start_tc": "00:52.80",
      "end_tc": "00:54.30",
      "text": "The slap rings out over the live microphone.",
      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 117
    },
    {
      "block_id": "E003-B026",
      "index": 26,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 55.0,
      "end_s": 60.5,
      "start_tc": "00:55.00",
      "end_tc": "01:00.50",
      "text": "Medium shot of Nora, tears on her face.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 121
    },
    {
      "block_id": "E003-B027",
      "index": 27,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 55.3,
      "end_s": 60.3,
      "start_tc": "00:55.30",
      "end_tc": "01:00.30",
      "text": "Ten years. Ten years I carried her, and you let me.",
      "speaker": {
        "label": "NORA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Furious",
          "Tearful"
        ]
      },
      "raw_label": "NORA (Furious, Tearful)",
      "source_line": 125
    },
    {
      "block_id": "E003-B028",
      "index": 28,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 60.5,
      "end_s": 64.0,
      "start_tc": "01:00.50",
      "end_tc": "01:04.00",
      "text": "Hollis, giddy, holds up his phone to show a live listener graph.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 129
    },
    {
      "block_id": "E003-B029",
      "index": 29,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 60.8,
      "end_s": 63.7,
      "start_tc": "01:00.80",
      "end_tc": "01:03.70",
      "text": "Keep going. Sixty thousand and climbing.",
      "speaker": {
        "label": "HOLLIS",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Delighted"
        ]
      },
      "raw_label": "HOLLIS (Delighted)",
      "source_line": 133
    },
    {
      "block_id": "E003-B030",
      "index": 30,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 64.0,
      "end_s": 73.7,
      "start_tc": "01:04.00",
      "end_tc": "01:13.70",
      "text": "Close-up on Maya in the booth doorway.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 137
    },
    {
      "block_id": "E003-B031",
      "index": 31,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 64.3,
      "end_s": 73.5,
      "start_tc": "01:04.30",
      "end_tc": "01:13.50",
      "text": "Turn it off, Mr. Hollis. Or tell them how much you paid to keep your nephew's car out of the papers.",
      "speaker": {
        "label": "MAYA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Cold"
        ]
      },
      "raw_label": "MAYA (Cold)",
      "source_line": 141
    },
    {
      "block_id": "E003-B032",
      "index": 32,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 73.7,
      "end_s": 76.2,
      "start_tc": "01:13.70",
      "end_tc": "01:16.20",
      "text": "Extreme close-up on Hollis, his smile frozen.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 145
    },
    {
      "block_id": "E003-B033",
      "index": 33,
      "scene_id": "E003-S02",
      "kind": "SOUND_FX",
      "start_s": 74.0,
      "end_s": 75.5,
      "start_tc": "01:14.00",
      "end_tc": "01:15.50",
      "text": "A sharp string sting.",
      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 149
    },
    {
      "block_id": "E003-B034",
      "index": 34,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 76.2,
      "end_s": 80.9,
      "start_tc": "01:16.20",
      "end_tc": "01:20.90",
      "text": "Close-up on Nora.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 153
    },
    {
      "block_id": "E003-B035",
      "index": 35,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 76.5,
      "end_s": 80.7,
      "start_tc": "01:16.50",
      "end_tc": "01:20.70",
      "text": "Your nephew. You hired him knowing what he did.",
      "speaker": {
        "label": "NORA",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Slow",
          "Realising"
        ]
      },
      "raw_label": "NORA (Slow, Realising)",
      "source_line": 157
    },
    {
      "block_id": "E003-B036",
      "index": 36,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 80.9,
      "end_s": 84.4,
      "start_tc": "01:20.90",
      "end_tc": "01:24.40",
      "text": "Wide shot of the booth as blue and red lights sweep across the window.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 161
    },
    {
      "block_id": "E003-B037",
      "index": 37,
      "scene_id": "E003-S02",
      "kind": "SOUND_FX",
      "start_s": 81.2,
      "end_s": 84.2,
      "start_tc": "01:21.20",
      "end_tc": "01:24.20",
      "text": "Police sirens rise outside.",
      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 165
    },
    {
      "block_id": "E003-B038",
      "index": 38,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 84.4,
      "end_s": 92.0,
      "start_tc": "01:24.40",
      "end_tc": "01:32.00",
      "text": "Close-up on Hollis, slipping his phone into his coat.",
      "speaker": null,
      "raw_label": "CAMERA",
      "source_line": 169
    },
    {
      "block_id": "E003-B039",
      "index": 39,
      "scene_id": "E003-S02",
      "kind": "DIALOGUE",
      "start_s": 84.7,
      "end_s": 91.8,
      "start_tc": "01:24.70",
      "end_tc": "01:31.80",
      "text": "Say one more word on air, and none of you will ever work in radio again.",
      "speaker": {
        "label": "HOLLIS",
        "character_id": null,
        "alias_hint": null,
        "voice": "ON",
        "delivery": [
          "Cold",
          "Threatening"
        ]
      },
      "raw_label": "HOLLIS (Cold, Threatening)",
      "source_line": 173
    },
    {
      "block_id": "E003-B040",
      "index": 40,
      "scene_id": "E003-S02",
      "kind": "CAMERA",
      "start_s": 92.0,
