      "speaker": null,
      "raw_label": "SOUND FX",
      "source_line": 18
    },
    {
      "block_id": "E002-B003",
      "index": 3,
      "scene_id": "E002-S01",
      "kind": "CAMERA",
      "start_s": 3.0,
      "end_s": 9.0,
      "start_tc": "00:03.00",
